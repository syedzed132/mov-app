# NXT FORM Production Environment Configuration Template
# Copy this file to .env before starting the production deployment.
# Infrastructure Budget: < CAD $50/month (Estimated actual: ~CAD $10-$15/month on VPS)

# --- Core Server Settings ---
NODE_ENV=production
PORT=3000
WEB_PORT=80
DATA_DIR=/data
TRUST_PROXY=1

# --- Security & Host Domain ---
# Set ORIGIN to your public HTTPS domain (e.g., https://app.nxtform.com)
ORIGIN=https://app.example.com
# RP_ID must match your domain hostname for WebAuthn/Passkey registration
RP_ID=app.example.com

# --- Nutrition Data Providers (Public Domain / Free Tier) ---
# USDA FoodData Central API Key (Free tier from https://fdc.nal.usda.gov/api-key-signup.html)
# Default DEMO_KEY allows 30 req/hour, 50 req/day; a free registered key provides 1,000 req/hour at $0.
USDA_API_KEY=DEMO_KEY

# --- Google OIDC Sign-In (Optional) ---
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Server Session Secret ---
# Generated automatically on first boot into DATA_DIR/secret if not provided.
# To generate manually: openssl rand -hex 32
# SESSION_SECRET=
